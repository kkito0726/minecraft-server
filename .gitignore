# サーバーの設定と実データ
.env
data/

# バックアップ（旧形式のリポジトリ直下と、管理コンソールの保管先）
# 先頭の / でリポジトリ直下に限定する。付けないと
# frontend/src/features/backups/ のようなソースまで巻き込む。
/backup-*.zip
/backups/

# 管理コンソール — バックエンド
/mcadmind
/mcadmind-arm64
backend/internal/presentation/webui/dist/*
!backend/internal/presentation/webui/dist/.gitkeep
coverage.out
coverage.html

# 結合テスト環境（test/）。ワールドとバックアップと秘密は追跡しない。
# data/ は先頭に / が無いので test/data/ も含まれる。
/test/.env
/test/backups/

# 管理コンソール — フロントエンド
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
