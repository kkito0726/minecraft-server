# 結合テスト用の設定。
#
#   cp test/server/.env.example test/server/.env
#   # ADMIN_TOKEN と RCON_PASSWORD を埋める（下のコマンドで生成）
#
# この .env は test/server/ の中だけで使う。本番の .env とは独立している。
# mcadmind には -project-dir <ここ> を渡すので、こちらが読まれる。
# Minecraft の設定と管理コンソールの設定が 1 つのファイルに同居するのは本番と同じ。

# --- Minecraft ---
# 本番と同じ版にしておくと、アーカイブの DataVersion を比較する経路まで通せる。
MC_VERSION=26.2
MC_TYPE=PAPER
MC_LEVEL=world
MC_SEED=
# flat は生成が速い。地形を見たいときだけ default にする。
MC_LEVEL_TYPE=flat
MC_MEMORY=1G
MC_MEM_LIMIT=2g
# 本番の 25565 とぶつけないためのホスト側ポート。
MC_PORT=25566
MC_MOTD="integration test"
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=5
MC_VIEW_DISTANCE=4
MC_SIMULATION_DISTANCE=4
MC_ONLINE_MODE=FALSE
MC_OPS=
TZ=Asia/Tokyo

# openssl rand -hex 16
RCON_PASSWORD=

# --- 管理コンソール（mcadmind） ---
# openssl rand -hex 32
# 32 文字未満だと起動時に止まる。
ADMIN_TOKEN=

# 本番の 8787 とぶつけない。
# コンテナの中では 0.0.0.0 で待つ必要がある（ホスト側は 8788 に公開する）。
ADMIN_ADDR=0.0.0.0:8787
ADMIN_BACKUP_DIR=backups

# --- ホスト側に公開するポート（test/compose.yaml が読む） ---
# 管理コンソール（埋め込みのフロントエンドを配信する。本番と同じ形）
ADMIN_PORT=8788
# Vite の開発サーバー。本番にこのコンテナは無い。
FRONTEND_PORT=5174
# 世代管理の境界を短い手数で試せるように、本番より小さくしてある。
ADMIN_BACKUP_KEEP=3
ADMIN_BACKUP_KEEP_DAYS=0
# 空にしてある。test/server/compose.yaml の name:（minecraft-server-test）が読まれる。
# ここを空にできるのが要点で、固定の定数だと本番のコンテナを操作してしまう。
ADMIN_COMPOSE_PROJECT=

ADMIN_DOCKER_BIN=docker
