# 結合テスト用の設定。
#
#   cp test/.env.example test/.env
#   # ADMIN_TOKEN と RCON_PASSWORD を埋める（下のコマンドで生成）
#
# この .env は test/ の中だけで使う。本番の .env とは独立している。
# mcadmind には -project-dir test を渡すので、こちらが読まれる。

# --- Minecraft ---
# 本番と同じ版にしておくと、アーカイブの DataVersion を比較する経路まで通せる。
MC_VERSION=26.2
MC_TYPE=PAPER
MC_LEVEL=world
MC_SEED=
# flat は生成が速い。地形を見たいときだけ default にする。
MC_LEVEL_TYPE=flat
MC_MEMORY=1G
MC_MEM_LIMIT=2g
# 本番の 25565 とぶつけないためのホスト側ポート。
MC_PORT=25566
MC_MOTD="integration test"
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=5
MC_VIEW_DISTANCE=4
MC_SIMULATION_DISTANCE=4
MC_ONLINE_MODE=FALSE
MC_OPS=
TZ=Asia/Tokyo

# openssl rand -hex 16
RCON_PASSWORD=

# --- 管理コンソール（mcadmind） ---
# openssl rand -hex 32
# 32 文字未満だと起動時に止まる。
ADMIN_TOKEN=

# 本番の 8787 とぶつけない。
ADMIN_ADDR=127.0.0.1:8788
ADMIN_BACKUP_DIR=backups
# 世代管理の境界を短い手数で試せるように、本番より小さくしてある。
ADMIN_BACKUP_KEEP=3
ADMIN_BACKUP_KEEP_DAYS=0
# 空にしてある。test/compose.yaml の name:（minecraft-server-test）が読まれる。
# ここを空にできるのが要点で、固定の定数だと本番のコンテナを操作してしまう。
ADMIN_COMPOSE_PROJECT=

ADMIN_DOCKER_BIN=docker
