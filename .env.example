# Raspberry Pi 5 (4GB) でサーバーを動かし、Tailscale 経由で接続する想定の設定。
# 別スペックのマシンで動かす場合は MC_MEMORY / MC_MEM_LIMIT / 距離設定を見直すこと。

# Minecraft のバージョン（クライアントと必ず合わせる）
MC_VERSION=26.2
# PAPER / VANILLA / FABRIC / FORGE など
MC_TYPE=PAPER

# --- ワールド ---
# 起動するワールド。実体は data/<名前>/ になる。
# 値を変えて docker compose up -d するとワールドが切り替わる（restart では反映されない）。
# 切替前のワールドは消えないので、名前を戻せばいつでも元に戻せる。
MC_LEVEL=world
# 新規ワールドを生成するときのシード。既存のワールドには影響しない。
# 生成が終わったら空に戻すこと。残っていると次に作るワールドが同じ地形になる。
MC_SEED=

# --- リソース（Pi 5 4GB 想定） ---
# JVM ヒープ。-Xms と -Xmx の両方になる。OS 用に 600MB 残すため 2G より上げない
MC_MEMORY=2G
# コンテナのメモリ上限。ヒープの 1.3〜1.4 倍が目安。超えると OOM kill + 自動再起動
MC_MEM_LIMIT=3g
# Aikar のフラグ。10GB 級のヒープ向けなので 2G では FALSE のまま
MC_AIKAR_FLAGS=FALSE

# --- 負荷に直結する設定 ---
MC_MAX_PLAYERS=5
# 描画に送るチャンクの範囲
MC_VIEW_DISTANCE=7
# エンティティ・レッドストーンを処理する範囲。view より重いので小さく
MC_SIMULATION_DISTANCE=5
# 同一 LAN 直結が確認できている場合のみ -1（圧縮無効）にする価値がある
MC_NETWORK_COMPRESSION_THRESHOLD=256

# --- ゲーム設定 ---
MC_MOTD="A Minecraft Server on Docker"
MC_DIFFICULTY=normal
# 正規アカウント認証。false にすると誰でも入れるので通常は TRUE
MC_ONLINE_MODE=TRUE
# OP にする Minecraft ID をカンマ区切りで指定
MC_OPS=
# 参加を許可する Minecraft ID をカンマ区切りで指定。
# 空でなければホワイトリストが自動で有効になる
MC_WHITELIST=
# ID を1つも入れずにホワイトリストだけ有効にしたい場合に TRUE。
# 通常は MC_WHITELIST に値を入れれば自動で有効になるので触らなくてよい。
# TRUE かつ MC_WHITELIST が空だと誰も入れなくなるので注意。
MC_ENABLE_WHITELIST=FALSE

TZ=Asia/Tokyo

# RCON 用パスワード。ポートは公開していないがコミットしないこと
RCON_PASSWORD=change-me

# --- 管理コンソール（mcadmind） ---
# 管理画面の共有トークン。32文字以上が必須で、短いと起動時にエラーで止まる。
# 生成: openssl rand -hex 32
ADMIN_TOKEN=
# 待ち受けアドレス。Tailscale 経由で別端末のブラウザから開くため 0.0.0.0 にする
# （compose が 25565 を 0.0.0.0 にバインドしているのと同じ理由）。
# 127.0.0.1 にすると Pi の中からしか開けない。到達制御は Tailscale が担う。
ADMIN_ADDR=0.0.0.0:8787
# バックアップ zip の保管先（リポジトリからの相対パス）
ADMIN_BACKUP_DIR=backups
# 残すバックアップの世代数。1 以上。取得成功のたびに古いものから削除される
ADMIN_BACKUP_KEEP=10
# 保持日数。0 で無効（世代数だけで判断する）
ADMIN_BACKUP_KEEP_DAYS=0
# docker コマンドのパス。PATH が通っていない systemd 配下では絶対パスにする
ADMIN_DOCKER_BIN=docker
