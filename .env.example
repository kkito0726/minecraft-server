# Raspberry Pi 5 (4GB) でサーバーを動かし、Tailscale 経由で接続する想定の設定。
# 別スペックのマシンで動かす場合は MC_MEMORY / MC_MEM_LIMIT / 距離設定を見直すこと。

# Minecraft のバージョン（クライアントと必ず合わせる）
MC_VERSION=26.2
# PAPER / VANILLA / FABRIC / FORGE など
MC_TYPE=PAPER

# --- リソース（Pi 5 4GB 想定） ---
# JVM ヒープ。-Xms と -Xmx の両方になる。OS 用に 600MB 残すため 2G より上げない
MC_MEMORY=2G
# コンテナのメモリ上限。ヒープの 1.3〜1.4 倍が目安。超えると OOM kill + 自動再起動
MC_MEM_LIMIT=3g
# Aikar のフラグ。10GB 級のヒープ向けなので 2G では FALSE のまま
MC_AIKAR_FLAGS=FALSE

# --- 負荷に直結する設定 ---
MC_MAX_PLAYERS=5
# 描画に送るチャンクの範囲
MC_VIEW_DISTANCE=7
# エンティティ・レッドストーンを処理する範囲。view より重いので小さく
MC_SIMULATION_DISTANCE=5
# 同一 LAN 直結が確認できている場合のみ -1（圧縮無効）にする価値がある
MC_NETWORK_COMPRESSION_THRESHOLD=256

# --- ゲーム設定 ---
MC_MOTD="A Minecraft Server on Docker"
MC_DIFFICULTY=normal
# 正規アカウント認証。false にすると誰でも入れるので通常は TRUE
MC_ONLINE_MODE=TRUE
# OP にする Minecraft ID をカンマ区切りで指定
MC_OPS=
# 参加を許可する Minecraft ID をカンマ区切りで指定。
# 空でなければホワイトリストが自動で有効になる
MC_WHITELIST=

TZ=Asia/Tokyo

# RCON 用パスワード。ポートは公開していないがコミットしないこと
RCON_PASSWORD=change-me
