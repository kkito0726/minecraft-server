# Minecraft のバージョン（クライアントと必ず合わせる）
MC_VERSION=26.2
# PAPER / VANILLA / FABRIC / FORGE など
MC_TYPE=PAPER
# 割り当てメモリ（Docker Desktop の VM メモリ上限を超えないこと）
MC_MEMORY=4G

MC_MOTD="A Minecraft Server on Docker"
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=10
MC_VIEW_DISTANCE=10
# 正規アカウント認証。false にすると誰でも入れるので通常は TRUE
MC_ONLINE_MODE=TRUE
# OP にする Minecraft ID をカンマ区切りで指定
MC_OPS=
# 参加を許可する Minecraft ID をカンマ区切りで指定。
# 空でなければホワイトリストが自動で有効になる。外部公開時は必須。
MC_WHITELIST=

TZ=Asia/Tokyo

# RCON 用パスワード。ポートは公開していないがコミットしないこと
RCON_PASSWORD=change-me

# ngrok の認証トークン（https://dashboard.ngrok.com/get-started/your-authtoken）
# docker compose --profile tunnel up -d で使う。未設定なら外部公開しないので空のままで可
NGROK_AUTHTOKEN=
